# @clara/backup: local rehearsal configuration; never commit real credentials.
# The script does not auto-load .env; supply the environment or use Node --env-file.
# Production configuration belongs to the backup app. See README.md, "Configuration".

# Database target: session connection, not transaction-mode pooling.
# The full profile reads accounting/engine schemas, ownership and ACLs; the job
# separately captures privileged auth data. Use the intended backup principal.
# Keep credentials in environment/secrets, not command-line arguments.
DATABASE_URL=
# Base connection fallback when no DSN is configured.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# Supabase Storage document mirror; use the project URL.
CLARA_BACKUP_STORAGE_URL=
# Mounted file containing the privileged backup Storage credential.
# This is separate from the runtime's restricted document-custody credential.
CLARA_BACKUP_STORAGE_KEY_FILE=/run/secrets/clara_storage_service_key
CLARA_BACKUP_STORAGE_BUCKET=firm-docs

# Cloudflare R2 via rclone.
CLARA_BACKUP_R2_BUCKET=clara-dr
CLARA_BACKUP_R2_REMOTE=r2
# rclone config file, or equivalent RCLONE_CONFIG_R2_* environment.
# See deploy/rclone.conf.example; keep token values out of argv.
RCLONE_CONFIG=/run/secrets/rclone.conf

# Public age recipient file; decryption needs the separately held private identity.
CLARA_BACKUP_AGE_RECIPIENTS_FILE=/app/packages/backup/deploy/age-recipient.txt

# Backup freshness monitor. A real run refuses missing monitoring configuration.
# Prefer a mounted URL file; neither form is logged verbatim.
# The rehearsal override below is for explicit local tests only.
CLARA_BACKUP_PING_URL=
CLARA_BACKUP_PING_URL_FILE=/run/secrets/clara_backup_ping_url
# CLARA_BACKUP_ALLOW_NO_PING=1   # test/rehearsal escape hatch — leave UNSET in prod

# Scratch directory and configured off-site retention.
CLARA_BACKUP_STAGING_DIR=/tmp/clara-backup
# Rolling recovery retention; this does not establish statutory archival compliance.
# Configure and verify the matching R2 lifecycle policy separately.
CLARA_BACKUP_RETENTION_DAYS=30

# PostgreSQL 17 client binaries; override paths for a local rehearsal.
PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
PG_DUMPALL=/usr/lib/postgresql/17/bin/pg_dumpall
PSQL=/usr/lib/postgresql/17/bin/psql
