# @clara/backup — copy to `.env` (gitignored) for LOCAL dry-run / rehearsal only.
# In production these are set as `fly secrets set` on the clara-backup app ONLY.
# NEVER commit real credentials. The DB connection is libpq PG*/DATABASE_URL only —
# never a DSN literal in code or argv. See docs/ops/DR.md §9.

# --- DB target (session pooler, port 5432 — NOT 6543) -----------------------
# Reads ALL schemas + ownership/ACLs + auth PII, so it is effectively the project
# admin role. Provide a Supabase SESSION-pooler connection string here: user is
# `postgres.<project-ref>`, host `<region>.pooler.supabase.com`, port 5432, db
# `postgres`. Keep it in the environment (a Fly secret) — never on a command line.
DATABASE_URL=
# libpq fallback (used when DATABASE_URL is unset):
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# --- Supabase Storage (firm-docs byte mirror) -------------------------------
# The project URL (https://<project-ref>.supabase.co).
CLARA_BACKUP_STORAGE_URL=
# Path to a FILE holding the service_role key (LIST/READ firm-docs). Read lazily,
# NEVER logged. In the Fly app this is a mounted secret file path.
CLARA_BACKUP_STORAGE_KEY_FILE=/run/secrets/clara_storage_service_key
CLARA_BACKUP_STORAGE_BUCKET=firm-docs

# --- Cloudflare R2 (rclone) -------------------------------------------------
CLARA_BACKUP_R2_BUCKET=clara-dr
CLARA_BACKUP_R2_REMOTE=r2
# Path to rclone.conf holding the R2 token (see deploy/rclone.conf.example). The token
# is NEVER passed on argv. Alternatively use RCLONE_CONFIG_R2_* env vars.
RCLONE_CONFIG=/run/secrets/rclone.conf

# --- age encryption (recipient = PUBLIC key; no secret needed to encrypt) ----
CLARA_BACKUP_AGE_RECIPIENTS_FILE=/app/packages/backup/deploy/age-recipient.txt

# --- Dead-man's-switch (healthchecks.io) ------------------------------------
# The ping URL carries a UUID (low-power secret). Prefer the *_FILE form in prod.
CLARA_BACKUP_PING_URL=
CLARA_BACKUP_PING_URL_FILE=/run/secrets/clara_backup_ping_url

# --- Local scratch + retention ----------------------------------------------
CLARA_BACKUP_STAGING_DIR=/tmp/clara-backup
# Off-site is DR (rolling 30-90d), NOT the 7-year statutory archive (that is the live
# DB + Supabase managed backups). R2 Object-Lifecycle prunes db-snapshots/ at this age.
CLARA_BACKUP_RETENTION_DAYS=30

# --- v17 client binaries (the image sets these; override for a local rehearsal) ---
PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
PG_DUMPALL=/usr/lib/postgresql/17/bin/pg_dumpall
PSQL=/usr/lib/postgresql/17/bin/psql
