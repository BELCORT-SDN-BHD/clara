    "build": "nitro build",
    "start": "node --env-file-if-exists=.env scripts/worker.mjs"
  },
  "dependencies": {
    "@workflow/world-postgres": "4.3.0",
    "express": "5.2.1",
    "nitro": "3.0.260610-beta",
    "pg": "8.20.0",
    "rollup": "4.62.2",
    "workflow": "4.6.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.0",
    "@types/pg": "8.15.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
