{
  "name": "@clara/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Clara agent-runtime service skeleton — the durable substrate (Workflow DevKit Postgres world) with health/ready probes. NO agent/LLM logic yet (that is Slice 4).",
