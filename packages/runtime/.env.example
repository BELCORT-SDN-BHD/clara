# @clara/runtime: local configuration examples. Never commit real credentials.
# This is not the full production variable inventory; see README.md,
# "Connection and service configuration", for all seven lanes and service settings.

# HTTP port; the embedded workflow worker dispatches to this port.
PORT=3200

# Workflow SDK world implementation.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Explicit durable-world opt-in. Production fly.toml enables it.
# World-off still requires configured pools; it does not bypass boot assertions.
CLARA_START_WORLD=0

# Database connections. The engine reads WORKFLOW_POSTGRES_URL;
# serve.mjs maps DATABASE_URL when needed. Use a session connection for
# LISTEN/NOTIFY and advisory locks, not a transaction-mode pooler.
DATABASE_URL=
WORKFLOW_POSTGRES_URL=
# Dedicated runtime and read logins for the same database.
# Production refuses missing DSNs. Base-identity/SET ROLE fallback is available
# only with RELAY_TEST_MODE=1 on disposable test estates.
CLARA_RUNTIME_DATABASE_URL=
CLARA_READ_DATABASE_URL=
# Interactive write login, with the clara_wake_interactive role.
# Required at production boot, alongside the runtime/read and freeform DSNs.
# Provision the login before starting the image; see README.md.
CLARA_WRITE_DATABASE_URL=
# Base connection fallback for tooling/test configuration, not missing production lane DSNs.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# Chat model. Admission snapshots the model for the task;
# changing this variable does not retarget an admitted run.
CLARA_CHAT_MODEL=gpt-5.6-terra
# OpenAI provider credential; tests can use an injected model.
OPENAI_API_KEY=

# Autodraft catch-up and stale-sweep finalization cadence, in seconds.
CLARA_AUTODRAFT_CATCHUP_SECONDS=300
# Legacy token-reservation estimate passed at admission.
# This is not a product spend limit; the current admission/settlement SQL owns its effect.
CLARA_AUTODRAFT_RESERVE_TOKENS=40000

# JWT validation for authenticated routes.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated
# Configure a JWKS URL for asymmetric tokens or a shared secret for HS256.
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_SECRET=

# Pool maxima. Include engine, consumers and probe sessions when sizing headroom.
CLARA_RUNTIME_POOL_MAX=5
CLARA_READ_POOL_MAX=5
# Interactive write pool maximum.
CLARA_WRITE_POOL_MAX=2

# Document egress switch. Held work may become eligible on the next reconciler cycle.
# Current consent, activation and dispatch checks remain separate; setting this
# variable does not establish client consent. See README.md.
CLARA_DOC_EGRESS_APPROVED=0
# Azure Document Intelligence endpoint and credential.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# clamd restarts with bounded backoff. Intake returns scanner_unavailable while down.
# A sufficiently long healthy run resets backoff; the scan deadline bounds a silent socket.
CLARA_CLAMD_MIN_BACKOFF_MS=2000
CLARA_CLAMD_MAX_BACKOFF_MS=60000
CLARA_CLAMD_HEALTHY_RUN_MS=60000
CLARA_CLAMD_SCAN_DEADLINE_MS=120000

# Document Storage custody. Provision the restricted role using
# packages/db/deploy/storage-provision.sql; do not substitute service_role.
CLARA_STORAGE_URL=
CLARA_STORAGE_ROLE=clara_storage_docs
CLARA_STORAGE_ROLE_JWT=
