# @clara/runtime — copy to `.env` (gitignored). NEVER commit real credentials.

# Port the server listens on (the embedded queue worker executes runs by
# loopback HTTP to this same port when the world is enabled).
PORT=3200

# Selects the Workflow DevKit world.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Durable world switch — EXPLICIT opt-in (default OFF = skeleton mode, health/ready
# only). The deployed app sets this to 1 via fly.toml [env]; neither serve.mjs nor
# worker.mjs defaults it, so a bare boot never attaches a worker to the engine.
CLARA_START_WORLD=0

# --- DB connections (env ONLY; no DSN literal in code) ---------------------
# The WDK world reads WORKFLOW_POSTGRES_URL; serve.mjs maps DATABASE_URL to it.
# Use a SESSION-mode pooler (port 5432) — the world needs LISTEN/NOTIFY, which
# transaction mode on 6543 drops.
DATABASE_URL=
WORKFLOW_POSTGRES_URL=
# The two runtime logins (§4.1 two-login pool contract). Each is a distinct
# credential from the environment; all point at the SAME database, different users.
# Absent + RELAY_TEST_MODE=1 -> connect as the base identity then SET ROLE (local
# throwaway, trust auth). Absent in prod -> the base identity + SET ROLE (fails
# loudly if the base login lacks the grant — N10).
CLARA_RUNTIME_DATABASE_URL=
CLARA_READ_DATABASE_URL=
# libpq fallback (used when no DSN is set).
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# --- Chat model (§0.3) -----------------------------------------------------
# Default model id, durably snapshotted per task at admission. An env change
# never retargets an admitted/parked run.
CLARA_CHAT_MODEL=gpt-5.6-terra
# The OpenAI provider reads this (production only; tests use a mock model).
OPENAI_API_KEY=

# --- JWT validation (§4.2; pinned, REQUIRED when serving chat) --------------
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated
# One of: a JWKS URL (asymmetric ES256/RS256) OR a shared secret (HS256).
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_SECRET=

# --- Pool sizing (§4.1 budget: 5 + 5 + 5 engine + 2 LISTEN = 17) -----------
CLARA_RUNTIME_POOL_MAX=5
CLARA_READ_POOL_MAX=5
