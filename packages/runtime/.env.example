# @clara/runtime — copy to `.env` (gitignored). NEVER commit real credentials.

# Port the server listens on (the embedded queue worker executes runs by
# loopback HTTP to this same port when the world is enabled).
PORT=3200

# Selects the Workflow DevKit world.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Durable world switch. Default OFF (skeleton mode = health/ready only).
# Set to 1 in Slice 4+ to start the durable engine's embedded worker.
CLARA_START_WORLD=0

# DB connection for the /ready probe and (when enabled) the world.
# Either a DSN (Supabase SESSION pooler, port 5432 — the world needs
# LISTEN/NOTIFY, which transaction mode on 6543 drops), OR libpq PG* vars.
# The world runtime reads WORKFLOW_POSTGRES_URL; worker.mjs maps DATABASE_URL to it.
DATABASE_URL=
WORKFLOW_POSTGRES_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
