# @clara/runtime — copy to `.env` (gitignored). NEVER commit real credentials.

# Port the server listens on (the embedded queue worker executes runs by
# loopback HTTP to this same port when the world is enabled).
PORT=3200

# Selects the Workflow DevKit world.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Durable world switch — EXPLICIT opt-in (default OFF = skeleton mode, health/ready
# only). The deployed app sets this to 1 via fly.toml [env]; neither serve.mjs nor
# worker.mjs defaults it, so a bare boot never attaches a worker to the engine.
CLARA_START_WORLD=0

# --- DB connections (env ONLY; no DSN literal in code) ---------------------
# The WDK world reads WORKFLOW_POSTGRES_URL; serve.mjs maps DATABASE_URL to it.
# Use a SESSION-mode pooler (port 5432) — the world needs LISTEN/NOTIFY, which
# transaction mode on 6543 drops.
DATABASE_URL=
WORKFLOW_POSTGRES_URL=
# The two runtime logins (§4.1 two-login pool contract). Each is a distinct
# credential from the environment; all point at the SAME database, different users.
# Absent + RELAY_TEST_MODE=1 -> connect as the base identity then SET ROLE (local
# throwaway, trust auth). Absent in prod -> the base identity + SET ROLE (fails
# loudly if the base login lacks the grant — N10).
CLARA_RUNTIME_DATABASE_URL=
CLARA_READ_DATABASE_URL=
# The Slice-6 write floor (contract §5): a THIRD login, clara_wake_write_login,
# member of clara_wake_interactive alone (single-membership law). The coding tool
# reaches the EXISTING wake_draft_entry writer through this login (SET ROLE
# clara_wake_interactive; NOT read-only; COMMITs). REQUIRED in production (fail-closed
# boot assert) — DEPLOY ORDER: 0009 creates the login NOLOGIN; the operator ceremony
# gives it LOGIN+password and sets this secret; it MUST be present before the Slice-6
# image boots or the world fails closed.
CLARA_WRITE_DATABASE_URL=
# libpq fallback (used when no DSN is set).
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# --- Chat model (§0.3) -----------------------------------------------------
# Default model id, durably snapshotted per task at admission. An env change
# never retargets an admitted/parked run.
CLARA_CHAT_MODEL=gpt-5.6-terra
# The OpenAI provider reads this (production only; tests use a mock model).
OPENAI_API_KEY=

# --- JWT validation (§4.2; pinned, REQUIRED when serving chat) --------------
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated
# One of: a JWKS URL (asymmetric ES256/RS256) OR a shared secret (HS256).
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_SECRET=

# --- Pool sizing (§4.1 budget: 5 + 5 + 5 engine + 2 LISTEN = 17; +2 write floor) ---
CLARA_RUNTIME_POOL_MAX=5
CLARA_READ_POOL_MAX=5
# The Slice-6 write floor is deliberately small (max 2 — the draft is a rare, human-
# initiated act; it never needs a large pool).
CLARA_WRITE_POOL_MAX=2

# --- Slice-6 coding floor + invoice facts + egress flip ---------------------
# Document egress to the OCR/invoice-facts vendors is OFF by default (world-off
# pattern). Flip via a SECRET OVERRIDE (fly.toml [env] stays 0; the ceremony sets the
# secret to 1) — recorded against S6-R1 + the signed RPR consent note. On flip the
# reconciler bulk-releases held_egress -> queued on its next cycle (the FIRST vendor
# egress). Verify the release count matches the held population and only RPR/synthetic
# docs exist.
CLARA_DOC_EGRESS_APPROVED=0
# Azure DI (used by BOTH the layout lane and the Slice-6 prebuilt-invoice lane).
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# NOTE: the per-document invoice-facts vendor-call cap is owned by the DATABASE (hard-
# coded to 3 in 0009's enqueue/claim path) — there is NO runtime env var for it, and Tier
# B is the honest permanent fallback once the cap is reached.
# clamd self-healing (PIN-AB-2): a clamd exit is non-fatal; the supervisor restarts it
# with bounded backoff and intake fails closed honestly (503 scanner_unavailable) while
# it is down. HEALTHY_RUN_MS: a clamd run lasting at least this long resets the backoff.
# SCAN_DEADLINE_MS: a scan-wide deadline so a connected-but-silent scanner fails closed
# rather than hanging (W6).
CLARA_CLAMD_MIN_BACKOFF_MS=2000
CLARA_CLAMD_MAX_BACKOFF_MS=60000
CLARA_CLAMD_HEALTHY_RUN_MS=60000
CLARA_CLAMD_SCAN_DEADLINE_MS=120000

# --- Slice-5 document Storage custody ---------------------------------------
# The ceremony provisions this exact custom role via
# packages/db/deploy/storage-provision.sql. Never use service_role here.
CLARA_STORAGE_URL=
CLARA_STORAGE_ROLE=clara_storage_docs
CLARA_STORAGE_ROLE_JWT=
