{
  "name": "@clara/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Clara data plane — versioned SQL migrations, seeds (synthetic only), ephemeral test rig, and the DR backup/restore tooling. The shared Postgres is the single source of truth.",
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:full": "node scripts/backup.mjs --profile full",
    "restore": "node scripts/restore.mjs",
    "restore:full": "node scripts/restore-full.mjs",
    "dr:selftest": "node scripts/dr-selftest.mjs",
    "dr:verify": "node scripts/dr-verify.mjs",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 --import ./tests/delta-preintegration-gate.mjs --import ./tests/rs-guard-preintegration-gate.mjs --import ./tests/theta-preintegration-gate.mjs --import ./tests/epsilon-preintegration-gate.mjs --import ./tests/zeta-preintegration-gate.mjs --import ./tests/eta-preintegration-gate.mjs --import ./tests/statutory-deadlines-preintegration-gate.mjs --import ./tests/f-a7-alpha-preintegration-gate.mjs --import ./tests/f-a7-beta-preintegration-gate.mjs --import ./tests/f-a7b-pr-a-preintegration-gate.mjs --import ./tests/proposal-basis-preintegration-gate.mjs --import ./tests/promotion-dup-open-wall-preintegration-gate.mjs --import ./tests/coa-template-pr-a-preintegration-gate.mjs --import ./tests/coa-template-pr-b-preintegration-gate.mjs --import ./tests/f-t3-pr-1-preintegration-gate.mjs --import ./tests/client-identifiers-unique-preintegration-gate.mjs --import ./tests/mdrw-preintegration-gate.mjs --import ./tests/checkout-gate-c1-preintegration-gate.mjs --import ./tests/f-a4-pr2c-close-chat-preintegration-gate.mjs --import ./tests/checkout-gate-c2-preintegration-gate.mjs tests/"
  },
  "dependencies": {
    "pg": "8.20.0"
  }
}
