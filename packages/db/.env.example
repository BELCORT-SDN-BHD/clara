# @clara/db — connection config. Copy to `.env` (gitignored) or export in your
# shell. NEVER commit real credentials.
#
# Two ways to point the scripts at a database (pick one):
#
# 1) libpq vars (REQUIRED for backup/restore — pg_dump/psql read these, not a DSN):
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
#
# 2) OR a full DSN for the node scripts (migrate/seed/reset/test).
#    Supabase: use the SESSION pooler (port 5432), NOT transaction mode (6543).
#    Shape (fill from the Supabase dashboard, Connect -> Session pooler):
#      scheme, then  postgres.PROJECT_REF : YOUR_PASSWORD @ HOST : 5432 / postgres
DATABASE_URL=
#
# DR backup only: if the PATH pg_dump is older than the server (this repo's
# server is Postgres 17), point PG_DUMP at a v17 binary. Optional PSQL override.
PG_DUMP=
PSQL=
