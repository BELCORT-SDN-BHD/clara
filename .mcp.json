{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [],
      "env": {}
    },
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    },
    "shadcn": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "pnpm", "--dir", "apps/web", "exec", "shadcn", "mcp"],
      "env": {}
    }
  }
