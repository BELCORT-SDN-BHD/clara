# Supabase Postgres - Supavisor SESSION mode (port 5432). NEVER transaction mode (6543):
# it drops LISTEN/NOTIFY, which both graphile-worker and the T5 probe need.
#
# Build the value from the Supabase dashboard (Connect -> Session pooler), shaped like:
#   postgres://  postgres.PROJECT_REF  :  YOUR_PASSWORD  @  aws-0-REGION.pooler.supabase.com  :  5432  /postgres
# (concatenated without spaces)
DATABASE_URL=

# Selects the Postgres world. The engine reads WORKFLOW_POSTGRES_URL and falls
# back to DATABASE_URL (verified: docs + @workflow/world-postgres cli).
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# The embedded queue worker executes runs by calling this server over
# loopback HTTP - PORT must match the port the server listens on.
PORT=3100

# Arm ONLY for acceptance test T4 (or use `pnpm worker:fault`):
# FAULT=kill-after-commit
