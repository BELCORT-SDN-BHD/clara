{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": [
    "nitro.config.ts",
    "src/**/*",
    "workflows/**/*",
    "plugins/**/*",
    "lib/**/*",
    "scripts/**/*"
  ]
}
