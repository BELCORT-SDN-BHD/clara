# @clara/dashboard — public config. NEXT_PUBLIC_* is exposed to the browser;
# NEVER put a secret in a NEXT_PUBLIC_* var. Copy to `.env.local` (gitignored).
NEXT_PUBLIC_CLARA_ENV=development

# --- Slice-4 chat page (plumbing-grade, contract §4.8) ----------------------
# The Clara runtime base URL AS SEEN FROM THE BROWSER. Leave EMPTY to use the
# same-origin dev proxy (next.config.mjs rewrites /api/chat + /api/tasks to
# CLARA_RUNTIME_PROXY_URL) — the runtime serves no CORS headers, so a direct
# cross-origin value only works against a CORS-enabled runtime deployment.
NEXT_PUBLIC_CLARA_RUNTIME_URL=
# Server-side proxy target used when NEXT_PUBLIC_CLARA_RUNTIME_URL is empty.
CLARA_RUNTIME_PROXY_URL=http://localhost:3200

# Supabase PostgREST — the HUMAN governance lane (answer_interruption /
# cancel_agent_task / share_chat_session + reads of agent_tasks_visible and
# agent_interruptions) on the user's session JWT. Governance NEVER transits the
# runtime (§4.2). The `clara` schema must be among the API's exposed schemas
# (the page selects it via Accept-Profile/Content-Profile headers).
# The anon key is publishable by design; the service key is NEVER used here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
