{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clara-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    // Enables Node.js APIs in the Worker runtime — required by @opennextjs/cloudflare.
    // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  // Committed, non-secret Worker configuration. Uploading a version replaces
  // the Worker's plain-text variables with this block, so change these values
  // here. Credentials and the deployment-specific mail sender remain Worker
  // secrets; README.md lists the six expected secret names.
  "vars": {
    // The runtime origin used by the same-origin proxy at request time. An
    // absent value produces a typed 503 for runtime-backed features.
    "CLARA_RUNTIME_URL": "https://clara-runtime.fly.dev",
    // The exact public origins this app answers as (scheme + host, comma-separated).
    // lib/same-origin.ts compares the browser's Origin against this list rather than
    // trusting X-Forwarded-Host, which is written by whoever spoke to us.
    "CLARA_PUBLIC_ORIGINS": "https://app.clarabook.com",
    // The Stripe mode this deployment declares, read at REQUEST time by
    // lib/checkout/stripe-session.ts, which refuses to create a Checkout Session
    // when the class of STRIPE_SECRET_KEY (sk_live_/rk_live_ vs sk_test_/rk_test_)
    // disagrees with it — in either direction. Unset ⇒ checkout refuses, because
    // "the deployment has not stated its mode" must never mean "accept anything"
    // on a money surface.
    //
    // NOT A SECRET (it is a public fact about this deployment), which is why it
    // lives here and not with `wrangler secret put` — the key itself stays a
    // secret. THE SAME NAME AND THE SAME CLOSED VOCABULARY the runtime's webhook
    // route already gates on (packages/runtime/lib/stripe-livemode.mjs), so both
    // arms of one deployment read one fact; the value is spelled the way the
    // runtime's own deploy env spells it.
    //
    // Closed beta uses Stripe test mode. A live switch also requires the
    // separately tracked KYB, pricing, legal, and non-zero checkout checks.
    "CLARA_STRIPE_LIVEMODE": "test",
    // On apps/web this is CF-Connecting-IP — the header THIS app's own Cloudflare edge
    // sets. Never X-Forwarded-For: any client can send it, and a wall keyed on a
    // client-settable header is a form field the attacker fills in. The RUNTIME's
    // same-named variable takes a different correct value (X-Clara-Client-IP); see
    // apps/web/.env.example for why the two differ.
    "CLARA_TRUSTED_CLIENT_IP_HEADER": "CF-Connecting-IP"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // No KV, R2, D1, or service bindings are declared today. Add any future
  // binding here and mirror it in open-next.config.ts.
}
