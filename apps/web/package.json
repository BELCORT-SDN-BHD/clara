{
  "name": "@clara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Clara web app (P1 foundation scaffold). Next.js App Router, deployed to Cloudflare Workers via @opennextjs/cloudflare; replaces apps/dashboard at cutover. See README.md for the rulings pointer and token provenance.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./test/bootstrap.mjs --import tsx --test lib/parts/catalog.test.tsx lib/parts/hooks.test.ts lib/wire.test.ts lib/session-accessor.test.ts tests/"
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  }
}
