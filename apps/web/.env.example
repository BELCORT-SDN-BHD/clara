# @clara/web environment template. Copy this file to the gitignored
# `.env.local` and fill values there. See README.md for setup and deployment.
# Never commit real credentials.

# Supabase Auth and PostgREST public configuration. Both values are exposed to
# the browser. The build rejects an empty key, a secret key, a service-role JWT,
# or any legacy JWT whose decoded role is not `anon`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exact public origins accepted by server-side same-origin checks, separated by
# commas. Include scheme, host, and any non-default port. A local development
# server can leave this empty; a deployment behind a proxy must set it.
# Example: https://app.clarabook.com,https://clarabook.com
CLARA_PUBLIC_ORIGINS=

# Allow plain-HTTP localhost or 127.0.0.1 origins outside NODE_ENV=development.
# Set only to `1` for a controlled local/test harness. Never enable in a
# deployed environment.
CLARA_ALLOW_INSECURE_LOOPBACK=

# Server-only invitation courier configuration. The invite endpoint refuses
# with `mail_not_configured` before creating an invite if any value is absent.

# Used only by the server-side invitation courier to call
# `auth.admin.generateLink`. Never expose this through a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API credential. The courier calls Resend over HTTPS and has no Resend
# package dependency.
RESEND_API_KEY=

# Verified sender for invitation mail, for example
# `Clara <invites@example.com>`. Resend rejects an unverified sender domain.
INVITE_MAIL_FROM=

# Runtime origin used by app/api/runtime/[...path]/route.ts at request time.
# Browser runtime traffic goes through this same-origin server proxy; there is
# deliberately no NEXT_PUBLIC_CLARA_RUNTIME_URL. When unset, the proxy returns
# `runtime_not_configured` with status 503.
CLARA_RUNTIME_URL=

# Server-only confirmation and checkout boundary configuration.

# Must exactly match the runtime value. Confirmation and checkout rate limits
# derive their keys using this pepper; different values would split one
# intended wall into independent counters.
CLARA_RATE_WALL_PEPPER=

# Trusted client-address header. On the Cloudflare-hosted web app this is
# `CF-Connecting-IP`. The runtime uses the same variable name with the value
# `X-Clara-Client-IP`, which is the header forwarded by the web server. Do not
# use a client-settable X-Forwarded-For value here.
CLARA_TRUSTED_CLIENT_IP_HEADER=

# Bearer shared with the runtime confirmation endpoint. It proves that an
# unauthenticated confirmation request came through this web server. The web
# and runtime values must match.
CLARA_AUTH_WALL_SERVICE_TOKEN=

# Server-only Stripe key. Closed beta uses a test/sandbox key. Never expose it
# through a NEXT_PUBLIC_ name.
STRIPE_SECRET_KEY=

# Declared Stripe mode. Checkout refuses before calling Stripe if this value
# and the key class disagree. Accepted values are 1/true/live and 0/false/test;
# an unset or unrecognised value refuses checkout. Production Worker config
# owns this non-secret value in wrangler.jsonc; this entry is for local use.
CLARA_STRIPE_LIVEMODE=test
