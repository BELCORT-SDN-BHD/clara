# dependencies
node_modules/
.pnpm-store/

# env / secrets (only *.example is tracked). ONE rule set: `.env*` ignores every env file at
# every depth, the two re-includes restore the placeholder TEMPLATES repo-wide (a bare `.env`
# / `.env.*` pair here used to be re-shadowed by a second `.env*` further down — consolidated
# 2026-09-06). Placeholders only; the leak-scan gate covers them.
.env*
!.env.example
!**/.env.example
*.pem

# build output
dist/
.output/
.nitro/
.next/
apps/web/e2e/.artifacts/
apps/web/e2e/.runtime/
apps/web/e2e/live-stack/.artifacts/
apps/web/e2e/live-stack/.artifacts-reports/
apps/web/e2e/live-stack/.runtime/
out/
*.tsbuildinfo

# apps/web — Cloudflare Workers build output (@opennextjs/cloudflare) + local
# wrangler dev state; never committed. wrangler's own local-secrets file
# (never a real credential in git regardless — constraint 4).
apps/web/.open-next/
apps/web/.wrangler/
apps/web/.dev.vars
apps/web/.dev.vars.*
apps/web/cloudflare-env.d.ts

# test / coverage
coverage/
.workflow-data/
.workflow-data-dryrun/

# storage.mjs local-fs fallback (RELAY_TEST_MODE=1 with no CLARA_TEST_STORAGE_DIR set lands
# here relative to CWD) — belt-and-suspenders alongside setting CLARA_TEST_STORAGE_DIR in
# every rig-gated test's before()
test-storage/

# DR / backups (may contain data — never commit)
backups/
*.dump
*.sql.gz

# logs / os
*.log
.DS_Store
Thumbs.db

# Local Claude Code state — track the shared harness (skills, path-scoped rules, the hook
# registration); keep session-local state (settings.local.json, caches, transcripts) out.
# Hook SCRIPTS live in scripts/hooks/, which is tracked normally — there is no .claude/hooks/.
.claude/*
!.claude/skills/
!.claude/rules/
!.claude/settings.json

# Codex-lane sandbox work dirs (reports + verification mirrors) — never committed
.tmp/
.tmp-corepack/

# Playwright MCP session output (snapshots, screenshots, staged upload files) — never tracked
.playwright-mcp/

# Codex CLI skills mirror (generated, machine-local)
.agents/
