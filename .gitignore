# dependencies
node_modules/
.pnpm-store/

# Environment examples contain placeholders; real credentials stay ignored.
.env*
!.env.example
!**/.env.example
*.pem

# build output
dist/
.output/
.nitro/
.next/
apps/web/e2e/.artifacts/
apps/web/e2e/.runtime/
apps/web/e2e/live-stack/.artifacts/
apps/web/e2e/live-stack/.artifacts-reports/
apps/web/e2e/live-stack/.runtime/
out/
*.tsbuildinfo

# Cloudflare build output and local Wrangler state/secrets.
apps/web/.open-next/
apps/web/.wrangler/
apps/web/.dev.vars
apps/web/.dev.vars.*
apps/web/cloudflare-env.d.ts

# test / coverage
coverage/
.workflow-data/
.workflow-data-dryrun/

# Local test Storage fallback.
test-storage/

# DR / backups (may contain data — never commit)
backups/
*.dump
*.sql.gz

# logs / os
*.log
.DS_Store
Thumbs.db

# Shared skills and hook registration are tracked; session state stays local.
.claude/*
!.claude/skills/
!.claude/settings.json

# Codex-lane sandbox work dirs (reports + verification mirrors) — never committed
.tmp/
.tmp-corepack/

# Playwright MCP session output (snapshots, screenshots, staged upload files) — never tracked
.playwright-mcp/

# Local Codex copies of .claude/skills and local-only skill additions.
.agents/
