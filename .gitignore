# dependencies
node_modules/
.pnpm-store/

# env / secrets (only *.example is tracked)
.env
.env.*
!.env.example
*.pem

# build output
dist/
.output/
.nitro/
.next/
out/
*.tsbuildinfo

# test / coverage
coverage/
.workflow-data/
.workflow-data-dryrun/

# DR / backups (may contain data — never commit)
backups/
*.dump
*.sql.gz

# logs / os
*.log
.DS_Store
Thumbs.db

# spike (frozen; keeps its own env)
spike/.env

# Local Claude Code state — track the full skills toolchain; keep everything else local.
.claude/*
!.claude/skills/
!.claude/hooks/

# Codex-lane sandbox work dirs (reports + verification mirrors) — never committed
.tmp/
.tmp-corepack/

.vercel
.env*
# Re-include env TEMPLATES repo-wide (restores the stated "only *.example is
# tracked" intent — the bare `.env*` above otherwise re-shadows the earlier
# `!.env.example`, which would silently un-track new placeholder templates like
# packages/backup/.env.example). Placeholders only; the leak-scan gate covers them.
!.env.example
!**/.env.example

# Playwright MCP session output (snapshots, screenshots, staged upload files) — never tracked
.playwright-mcp/
